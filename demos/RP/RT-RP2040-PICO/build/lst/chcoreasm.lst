 160              	#if CH_DBG_STATISTICS
 161              	                bl      __stats_start_measure_crit_thd
 162              	#endif
 163              	#if CH_DBG_SYSTEM_STATE_CHECK
 164              	                bl      __dbg_check_lock
 165              	#endif
 166 0032 FFF7FEFF 	                bl      chSchDoPreemption
 167              	#if CH_DBG_SYSTEM_STATE_CHECK
 168              	                bl      __dbg_check_unlock
 169              	#endif
 170              	#if CH_DBG_STATISTICS
 171              	                bl      __stats_stop_measure_crit_thd
 172              	#endif
 173              	                .globl  __port_exit_from_isr
 174              	__port_exit_from_isr:
 175 0036 024A     	                ldr     r2, =SCB_ICSR
 176              	#if CORTEX_ALTERNATE_SWITCH
 177              	                ldr     r3, =ICSR_PENDSVSET
 178              	#else
 179 0038 4FF00043 	                ldr     r3, =ICSR_NMIPENDSET
 180              	#endif
