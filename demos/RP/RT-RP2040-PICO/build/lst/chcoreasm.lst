  73              	/*--------------------------------------------------------------------------*
  74              	 * Performs a context switch between two threads.
  75              	 *--------------------------------------------------------------------------*/
  76              	                .thumb_func
  77              	                .globl  __port_switch
  78              	__port_switch:
  79 0000 F0B5     	                push    {r4, r5, r6, r7, lr}
  80 0002 4446     	                mov     r4, r8
  81 0004 4D46     	                mov     r5, r9
  82 0006 5646     	                mov     r6, r10
  83 0008 5F46     	                mov     r7, r11
  84 000a F0B4     	                push    {r4, r5, r6, r7}
  85              	# #if CORTEX_USE_FPU
  86              	#                 /* Saving FPU context.*/
  87              	#                 vpush   {s16-s31}
  88              	# #endif
  89              	
  90              	# #if CH_DBG_ENABLE_STACK_CHECK
  91              	#                 /* Saving stack limit register.*/
  92              	#                 mrs     r3, PSPLIM
  93              	#                 push    {r3}
  94              	#                 movs    r3, #0
  95              	#                 msr     PSPLIM, r3      /* Temporarily disabling stack check.*/
  96              	# #endif
  97              	
  98              	                /* Switching stacks.*/
  99 000c 6B46     	                mov     r3, sp
 100 000e CB60     	                str     r3, [r1, #CONTEXT_OFFSET]
 101 0010 C368     	                ldr     r3, [r0, #CONTEXT_OFFSET]
 102 0012 9D46     	                mov     sp, r3
 103              	
 104              	# #if CH_DBG_ENABLE_STACK_CHECK
 105              	#                 pop     {r3}
 106              	#                 msr     PSPLIM, r3
 107              	# #endif
 108              	
 109              	# #if CORTEX_USE_FPU
 110              	#                 /* Restoring FPU context.*/
 111              	#                 vpop    {s16-s31}
 112              	# #endif
 113 0014 F0BC     	                pop     {r4, r5, r6, r7}
 114 0016 A046     	                mov     r8, r4
 115 0018 A946     	                mov     r9, r5
 116 001a B246     	                mov     r10, r6
 117 001c BB46     	                mov     r11, r7
 118 001e F0BD     	                pop     {r4, r5, r6, r7, pc}
 119              	/*--------------------------------------------------------------------------*
 120              	 * Start a thread by invoking its work function.
 121              	 *
 122              	 * Threads execution starts here, the code leaves the system critical zone
 123              	 * and then jumps into the thread function passed in register R4. The
ARM GAS  /tmp/cc8KA7qK.s 			page 6


 124              	 * register R5 contains the thread parameter. The function chThdExit() is
 125              	 * called on thread function return.
 126              	 *--------------------------------------------------------------------------*/
 127              	                .thumb_func
 128              	                .globl  __port_thread_start
 129              	__port_thread_start:
 130              	#if CH_DBG_SYSTEM_STATE_CHECK
 131              	                bl      __dbg_check_unlock
 132              	#endif
 133              	#if CH_DBG_STATISTICS
 134              	                bl      __stats_stop_measure_crit_thd
 135              	#endif
 136              	#if CH_CFG_SMP_MODE == TRUE
 137 0020 FFF7FEFF 	                bl      __port_spinlock_release
 138              	#endif
 139              	#  must define CORTEX_SIMPLIFIED_PRIORITY in rp2350
 140              	#if CORTEX_SIMPLIFIED_PRIORITY
 141 0024 62B6     	                cpsie   i
 142              	#else
 143              	                 movs    r3, #0              /* CORTEX_BASEPRI_DISABLED */
 144              	                 msr     BASEPRI, r3
 145              	#endif
 146 0026 2846     	                mov     r0, r5
 147 0028 A047     	                blx     r4
 148 002a 0020     	                movs    r0, #0              /* MSG_OK */
 149 002c FFF7FEFF 	                bl      chThdExit
 150 0030 FEE7     	1:              b       1b
 151              	
 152              	/*--------------------------------------------------------------------------*
 153              	 * Post-IRQ switch code.
 154              	 *
 155              	 * Exception handlers return here for context switching.
 156              	 *--------------------------------------------------------------------------*/
 157              	                .thumb_func
 158              	                .globl  __port_switch_from_isr
